pipeline {
    agent any

    // --- Parameters block: parent pipeline se IMAGE_TAG receive karega ---
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag passed from parent pipeline')
    }

    environment {
        AWS_ACCOUNT_ID = "802749364888"
        AWS_REGION = "ap-south-1"
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        //GALAT: IMAGE_TAG = "${params.IMAGE_TAG}" environment block me mat rakho
        //SAHI: IMAGE_TAG ko directly params se stages ke andar use karo
        // Reason: environment block string literal treat karta hai, params inject nahi hota
        EC2_HOST = "ubuntu@52.66.168.244"
        EC2_KEY = "/var/lib/jenkins/.ssh/his-key-ap-south-1-openssh.pem"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/deepamunesh/his-project.git'
            }
        }

        stage('Build JAR') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Docker Build & Push') {
            steps {
                sh """
                    # --- AWS ECR Login Step ---
                    aws ecr get-login-password --region ${AWS_REGION} \
                    | docker login --username AWS --password-stdin ${ECR_REGISTRY}

                    # GALAT: docker build -t api-gateway:${IMAGE_TAG} API-GATEWAY /
                    # SAHI: use params.IMAGE_TAG and remove space-slash
                    docker build -t api-gateway:${params.IMAGE_TAG} API-GATEWAY/
                    docker tag api-gateway:${params.IMAGE_TAG} ${ECR_REGISTRY}/api-gateway:${params.IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/api-gateway:${params.IMAGE_TAG}
                """
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    # Copy updated compose file to EC2
                    scp -i ${EC2_KEY} docker-compose.yml ${EC2_HOST}:/home/ubuntu/his-deployment/

                    # GALAT: IMAGE_TAG=${BUILD_NUMBER}
                    # SAHI: IMAGE_TAG=${params.IMAGE_TAG}
                    ssh -i ${EC2_KEY} ${EC2_HOST} "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY} && cd /home/ubuntu/his-deployment && echo IMAGE_TAG=${params.IMAGE_TAG} > .env && docker-compose --env-file .env pull && docker-compose --env-file .env up -d"
                '''
            }
        }
    }
}
